{
  "compilerOptions": {
    "paths": {
      "@/*": ["./src/*"]
    },
    "target": "es2016",
    "module": "es2020",
    "types": [
      "vite/client",
      "node"
    ],
    "include": [
      "./src/**/*",
    ],
    "moduleResolution": "node",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": false
  }
}
